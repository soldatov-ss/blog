---
import { getCollection } from 'astro:content';
import Divider from '../components/Divider.astro';
import PostGrid from '../components/PostGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<span class="sr-eyebrow">Writing on software</span>
		<h1 class="sr-display">Notes from building software, <em>one</em> commit at a time</h1>
		<p class="sr-lede">
			I'm Serhii Soldatov. I write about software engineering: architecture, tooling, and what I learned
			shipping real systems.
		</p>
		<div class="actions">
			<a class="sr-btn sr-btn--primary" href="/blog">
				Read the articles
				<svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</a>
			<a class="sr-btn sr-btn--outline" href="/rss.xml">Subscribe via RSS</a>
		</div>
	</section>

	<Divider />

	<section class="section">
		<div class="section-head">
			<h2 class="sr-heading">Latest articles</h2>
			<a class="sr-link" href="/blog">All articles</a>
		</div>
		<PostGrid posts={posts} />
	</section>
</Layout>
