---
import Divider from '../components/Divider.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';
import { getPosts } from '../posts';

const [latest, ...rest] = await getPosts();
const more = rest.slice(0, 4);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<!-- ponytail: hero copy is drafted from the one published essay; replace with your own words. -->
		<h1 class="sr-display">
			Changing software that people <em>already</em> rely on
		</h1>
		<p class="sr-lede">
			I’m Serhii Soldatov, a software engineer. I write long-form notes on architecture, access control and refactoring
			live systems: what we changed, and how we proved nothing broke.
		</p>
	</section>
	<div class="hero-foot">
		<Divider />
	</div>

	{latest && (
		<section class="section" aria-label="Latest essay">
			<PostCard post={latest} featured />
		</section>
	)}

	{more.length > 0 && (
		<section class="section">
			<div class="section-head">
				<h2 class="sr-heading">More essays</h2>
				<a class="sr-link" href="/blog/">
					All articles
				</a>
			</div>
			<div class="post-grid">
				{more.map((post) => (
					<PostCard post={post} />
				))}
			</div>
		</section>
	)}
</Layout>
