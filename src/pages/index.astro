---
import { getCollection } from 'astro:content';
import PostGrid from '../components/PostGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="glow" aria-hidden="true"></div>
		<p class="eyebrow">Writing on software</p>
		<h1>Notes from building software, <em>one commit</em> at a time</h1>
		<p class="lede">
			I'm Serhii Soldatov. I write about software engineering: architecture, tooling, and lessons
			learned shipping real systems.
		</p>
		<div class="actions">
			<a class="btn" href="/blog">Read the articles →</a>
			<a class="btn btn-outline" href="/rss.xml">Subscribe via RSS</a>
		</div>
	</section>

	<section class="latest">
		<div class="section-head">
			<h2>Latest articles</h2>
			<a href="/blog">View all →</a>
		</div>
		<PostGrid posts={posts} />
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		max-width: 760px;
		margin: 0 auto;
		padding: 120px 0 96px;
		text-align: center;
	}
	.glow {
		position: absolute;
		inset: 40px -20% auto;
		height: 320px;
		z-index: -1;
		background: var(--dawn-wash);
		filter: blur(90px);
		opacity: 0.35;
		border-radius: 50%;
	}
	.lede {
		max-width: 560px;
		margin: 0 auto 32px;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 32px;
	}
	.section-head h2 {
		margin: 0;
	}
	.section-head a {
		font-size: 16px;
		font-weight: 500;
		color: var(--accent-text);
		text-decoration: none;
	}
	@media (max-width: 720px) {
		.hero {
			padding: 72px 0 64px;
		}
	}
</style>
