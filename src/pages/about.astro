---
import { SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`About · ${SITE_TITLE}`} description="About Serhii Soldatov.">
	<header class="page-head">
		<p class="eyebrow">About</p>
		<h1>Hi, I'm <em>Serhii</em></h1>
	</header>
	<div class="prose">
		<!-- TODO: replace with your own bio -->
		<p>
			I'm a software engineer. This blog is where I write about the things I build, the tools I use,
			and the lessons I pick up along the way.
		</p>
		<p>
			New articles show up on the <a href="/blog">articles page</a>, and you can follow along via
			<a href="/rss.xml">RSS</a>.
		</p>
	</div>
</Layout>

<style>
	.page-head {
		max-width: var(--prose-width);
		margin: 0 auto;
		padding: 96px 0 32px;
	}
</style>
