---
import { SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`About · ${SITE_TITLE}`} description="About Serhii Soldatov.">
	<header class="sr-article-head">
		<h1 class="sr-display">Hi, I'm <em>Serhii</em></h1>
		<hr class="sr-seam" />
	</header>
	<div class="sr-prose">
		<!-- TODO(serhii): replace with your own bio: what you work on, where, and how to reach you. -->
		<p>
			I'm a software engineer. This blog is where I write about the things I build, the tools I use, and the
			lessons I pick up along the way.
		</p>
		<p>
			New essays show up on the <a href="/blog/">articles page</a>, and you can follow along with the{' '}
			<a href="/rss.xml">RSS feed</a>.
		</p>
	</div>
</Layout>
