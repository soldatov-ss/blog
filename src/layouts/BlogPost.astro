---
// Sirene article: cover → ArticleHeader → contents → prose (CodeBlock) → tags → more essays → RSS.
import { getImage, Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import Divider from '../components/Divider.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { markdownUrl, type Post, postUrl, readingMinutes } from '../posts';
import Layout from './Layout.astro';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	newer?: Post;
	older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroStill, tags, canonicalUrl } = post.data;
const sections = headings.filter((heading) => heading.depth === 2);
// An animated cover holds still (its heroStill frame) for readers who ask for reduced motion.
const stillCover = heroStill && (await getImage({ src: heroStill, width: 1080, format: 'webp' }));
---

<Layout
	title={title}
	description={description}
	image={heroStill ?? heroImage}
	published={pubDate}
	modified={updatedDate}
	markdown={markdownUrl(post)}
	canonical={canonicalUrl}
>
	{heroImage && (
		<figure class="hero-image sr-stitched">
			<picture>
				{stillCover && <source srcset={stillCover.src} media="(prefers-reduced-motion: reduce)" />}
				<Image src={heroImage} width={1080} alt="" loading="eager" />
			</picture>
		</figure>
	)}

	<header class="sr-article-head">
		<h1 class="sr-display">{title}</h1>
		<p class="sr-lede">{description}</p>
		<div class="sr-byline">
			<span class="sr-meta">
				<FormattedDate date={pubDate} />
			</span>
			<span class="sr-meta">· {readingMinutes(post)} min read</span>
			{updatedDate && (
				<span class="sr-meta">
					· Updated <FormattedDate date={updatedDate} />
				</span>
			)}
		</div>
		<hr class="sr-seam" />
	</header>

	{sections.length > 2 && (
		<details class="toc">
			<summary>
				Contents <span class="toc__count">{sections.length} sections</span>
			</summary>
			<ol>
				{sections.map((heading) => (
					<li>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))}
			</ol>
		</details>
	)}

	<article class="sr-prose">
		<slot />
	</article>
	<dialog class="zoom" aria-label="Full-size image"></dialog>
	<script>
		// Screenshots are shrunk to the 680px column; clicking one opens it full size in a native modal
		// (Esc and focus return come free). Any click inside closes it.
		const dialog = document.querySelector<HTMLDialogElement>('dialog.zoom')!;
		const big = dialog.appendChild(new Image());
		dialog.addEventListener('click', () => dialog.close());
		for (const img of document.querySelectorAll<HTMLImageElement>('.sr-prose img')) {
			const button = document.createElement('button');
			button.className = 'zoom-trigger';
			button.ariaLabel = `Enlarge image: ${img.alt}`;
			img.replaceWith(button);
			button.append(img);
			button.addEventListener('click', () => {
				big.src = img.currentSrc || img.src;
				big.alt = img.alt;
				dialog.showModal();
			});
		}
	</script>

	<footer class="article-end">
		<Divider />
		{canonicalUrl && (
			<p class="sr-meta original">
				Originally published on <a href={canonicalUrl}>{new URL(canonicalUrl).hostname.replace(/^www\./, '')}</a>
			</p>
		)}
		{tags.length > 0 && <TagList tags={tags} />}
		{(newer || older) && (
			<nav class="more" aria-label="More essays">
				{older && (
					<a class="more__link" href={postUrl(older)}>
						<span class="sr-meta">Older</span>
						<span class="sr-subheading">{older.data.title}</span>
					</a>
				)}
				{newer && (
					<a class="more__link more__link--newer" href={postUrl(newer)}>
						<span class="sr-meta">Newer</span>
						<span class="sr-subheading">{newer.data.title}</span>
					</a>
				)}
			</nav>
		)}
		<section class="subscribe" aria-labelledby="subscribe-title">
			<h2 class="sr-heading" id="subscribe-title">
				New essays, <em>whenever</em> they're ready
			</h2>
			<p>Follow along in any feed reader. No tracking, no email needed.</p>
			<a class="sr-btn sr-btn--outline" href="/rss.xml">
				RSS feed
			</a>
		</section>
	</footer>
</Layout>
