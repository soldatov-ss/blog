---
// Sirene article: ArticleHeader → prose (CodeBlock, Callout) → floret divider → subscribe.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Divider from '../components/Divider.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import { SITE_TITLE } from '../consts';
import Layout from './Layout.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: string };

const { title, description, pubDate, updatedDate, heroImage, tags = [], readingTime } = Astro.props;
---

<Layout title={title} description={description} image={heroImage}>
	<header class="sr-article-head">
		{tags[0] && <a class="sr-eyebrow" href={`/tags/${tags[0]}/`}>{tags[0]}</a>}
		<h1 class="sr-display">{title}</h1>
		<p class="sr-lede">{description}</p>
		<div class="sr-byline">
			<span class="sr-meta">{SITE_TITLE}</span>
			<span class="sr-meta">· <FormattedDate date={pubDate} /></span>
			{readingTime && <span class="sr-meta">· {readingTime}</span>}
			{updatedDate && <span class="sr-meta">· Updated <FormattedDate date={updatedDate} /></span>}
		</div>
		<hr class="sr-seam" />
	</header>

	{heroImage && (
		<figure class="hero-image sr-stitched">
			<Image src={heroImage} width={1080} height={540} alt="" />
		</figure>
	)}

	<article class="sr-prose">
		<slot />
	</article>

	<footer class="article-end">
		<Divider />
		{tags.length > 0 && <TagList tags={tags} />}
		<section class="subscribe" id="subscribe">
			<span class="sr-eyebrow">Subscribe</span>
			<h2 class="sr-heading">New essays, <em>whenever</em> they're ready</h2>
			<p>Follow along in any feed reader. No tracking, no email needed.</p>
			<a class="sr-btn sr-btn--primary" href="/rss.xml">Subscribe via RSS</a>
		</section>
	</footer>

	<script>
		for (const button of document.querySelectorAll<HTMLButtonElement>('.sr-code__copy')) {
			button.addEventListener('click', async () => {
				const code = button.closest('.sr-code')?.querySelector('pre')?.innerText ?? '';
				await navigator.clipboard.writeText(code);
				button.textContent = 'Copied';
				setTimeout(() => (button.textContent = 'Copy'), 2000);
			});
		}
	</script>
</Layout>
