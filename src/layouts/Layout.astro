---
// Every page uses the Sirene design system (sirene-design-system/). Nav → slot → Footer.
import '../../sirene-design-system/tokens.css';
import '../../sirene-design-system/components/bundle.css';
import '../styles/site.css';
import BaseHead from '../components/BaseHead.astro';
import type { ComponentProps } from 'astro/types';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

type Props = ComponentProps<typeof BaseHead>;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {...Astro.props} />
	</head>
	<body class="sr">
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<!-- Tweed stops at the footer so the bottom band shows like the top one. -->
		<div class="sr-page">
			<div class="page nav-wrap">
				<Nav />
			</div>
			<main class="page" id="main" tabindex="-1">
				<slot />
			</main>
		</div>
		<Footer />
		<script>
			import '../code-block/copy';
		</script>
	</body>
</html>
