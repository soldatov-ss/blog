---
// Sirene PostCard: sirene-design-system/components/PostCard (stitched patch, no cover image)
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<a class="sr-card sr-stitched" href={`/blog/${post.id}/`}>
	{tags[0] && <span class="sr-eyebrow">{tags[0]}</span>}
	<h3 class="sr-subheading">{title}</h3>
	<p class="sr-card__excerpt">{description}</p>
	<div class="sr-card__foot">
		<span class="sr-meta"><FormattedDate date={pubDate} /></span>
		<span class="sr-meta">· {readingTime(post.body).replace(' read', '')}</span>
	</div>
</a>
