---
// Share line at the end of an article: Copy link, plus the device share sheet where the browser has one.
// Without a share sheet (most desktop browsers) it falls back to plain links to each network's share page,
// so no third-party scripts or trackers load either way.
interface Props {
	title: string;
}

const url = Astro.url.href;
const u = encodeURIComponent(url);
const t = encodeURIComponent(Astro.props.title);
const targets = [
	{ label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
	{ label: 'X', href: `https://x.com/intent/post?url=${u}&text=${t}` },
	{ label: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
	{ label: 'Hacker News', href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}` },
];
---

<section class="share" aria-label="Share this essay" data-url={url} data-title={Astro.props.title}>
	<button class="sr-btn sr-btn--outline share__copy" type="button">
		Copy link
	</button>
	<button class="sr-btn sr-btn--outline share__native" type="button" hidden>
		Share…
	</button>
	<span class="share__networks">
		{targets.map(({ label, href }) => (
			<a href={href} target="_blank" rel="noopener">
				<span class="sr-only">Share on </span>
				{label}
			</a>
		))}
	</span>
	<span class="sr-meta share__status" role="status"></span>
</section>

<script>
	for (const box of document.querySelectorAll<HTMLElement>('.share')) {
		const { url = location.href, title = document.title } = box.dataset;
		const status = box.querySelector('.share__status')!;
		if (navigator.share) {
			const native = box.querySelector<HTMLButtonElement>('.share__native')!;
			native.hidden = false;
			box.querySelector<HTMLElement>('.share__networks')!.hidden = true;
			native.addEventListener('click', () => navigator.share({ url, title }).catch(() => {}));
		}
		box.querySelector('.share__copy')!.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(url);
				status.textContent = 'Link copied';
			} catch {
				status.textContent = url;
			}
		});
	}
</script>
