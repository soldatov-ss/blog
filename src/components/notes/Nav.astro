---
// Serhii's Notes Nav: serhiis-notes-design-system/components/Nav
import { SITE_TITLE } from '../../consts';

const links = [
	['/blog', 'Articles'],
	['/about', 'About'],
];
const path = Astro.url.pathname;
---

<nav class="sn-nav" aria-label="Main">
	<div class="sn-nav__links">
		{links.map(([href, label]) => (
			<a class="sn-nav__link" href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
				{label}
			</a>
		))}
	</div>
	<a class="sn-nav__logo" href="/">{SITE_TITLE}</a>
	<div class="sn-nav__actions">
		<button class="sn-icon-btn" id="theme-toggle" type="button" aria-label="Switch theme">
			<svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path d="M13 9.5A5.5 5.5 0 1 1 6.5 3 4.5 4.5 0 0 0 13 9.5Z"></path>
			</svg>
			<svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
				<circle cx="8" cy="8" r="3"></circle>
				<path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"></path>
			</svg>
		</button>
		<a class="sn-btn sn-btn--primary sn-btn--sm" href="#subscribe">Subscribe</a>
	</div>
</nav>

<script>
	const root = document.documentElement;
	const button = document.getElementById('theme-toggle');
	// The toggle names the theme it switches to: Clair (day) or Obscur (night).
	const label = () =>
		button?.setAttribute(
			'aria-label',
			root.dataset.theme === 'dark' ? 'Switch to Clair (day) theme' : 'Switch to Obscur (night) theme',
		);
	label();
	button?.addEventListener('click', () => {
		root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		try {
			localStorage.setItem('theme', root.dataset.theme);
		} catch {}
		label();
	});
</script>

<style>
	:global([data-theme='dark']) .moon,
	:global(:root:not([data-theme='dark'])) .sun {
		display: none;
	}
	@media (max-width: 640px) {
		.sn-nav__logo {
			font-size: 24px;
		}
	}
</style>
