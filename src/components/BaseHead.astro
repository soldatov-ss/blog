---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { DAY_THEME, NIGHT_THEME, SITE_TITLE, SOCIAL_LINKS, THEME_KEY } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Set on article pages: emits og:type=article and its dates. */
	published?: Date;
	modified?: Date;
	/** Raw Markdown copy of this page, advertised to agents via rel=alternate. */
	markdown?: string;
	/** Original URL when the page is a republished copy; defaults to this page. */
	canonical?: string;
	/** Keep this page out of search results (404, thin tag pages). */
	noindex?: boolean;
}

const { title, description, image, published, modified, markdown, canonical, noindex } = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '');

// A 1200px JPEG for link previews. Pass a still: animated GIFs are too large for social cards (see heroStill).
const shareImage = image && new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, Astro.url);

// schema.org: who the author is and what each page is, so search engines and AI answer engines attribute and cite it.
// One Person @id across pages lets them join the posts, the About page and the profiles into one entity.
const person = {
	'@type': 'Person',
	'@id': new URL('/about/#person', Astro.site),
	name: SITE_TITLE,
	jobTitle: 'Software engineer',
	url: new URL('/about/', Astro.site),
	sameAs: SOCIAL_LINKS.map((link) => link.href),
};
const ld = published
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			url: canonicalURL,
			mainEntityOfPage: canonicalURL,
			inLanguage: 'en',
			datePublished: published.toISOString(),
			dateModified: (modified ?? published).toISOString(),
			author: person,
			...(shareImage && { image: shareImage }),
		}
	: path === ''
		? {
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'WebSite',
						'@id': new URL('/#website', Astro.site),
						url: new URL('/', Astro.site),
						name: SITE_TITLE,
						description,
						inLanguage: 'en',
						publisher: { '@id': person['@id'] },
					},
					person,
				],
			}
		: path === '/about' && {
				'@context': 'https://schema.org',
				'@type': 'ProfilePage',
				url: canonicalURL,
				mainEntity: person,
			};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- PNGs for browsers and crawlers that skip SVG icons (Safari, Google Search); rendered from favicon.svg. -->
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<!-- Copies of --surface-canvas (sirene-design-system/tokens.css): meta tags can't read CSS variables. -->
<meta name="theme-color" content="#faf4ec" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1b1117" media="(prefers-color-scheme: dark)" />

<!-- Self-hosted at build time (astro.config.mjs `fonts`); preload only the two faces above the fold. -->
<Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
<Font cssVariable="--font-bricolage" preload />
<Font cssVariable="--font-jetbrains" />

<!-- Apply a saved theme before paint. With none, tokens.css follows prefers-color-scheme. -->
<script is:inline define:vars={{ THEME_KEY, DAY_THEME, NIGHT_THEME }}>
	try {
		const saved = localStorage.getItem(THEME_KEY);
		if (saved === DAY_THEME || saved === NIGHT_THEME) document.documentElement.dataset.theme = saved;
	} catch {}
</script>

<!-- Canonical URL -->
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld).replaceAll('<', '\\u003c')} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={published ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{shareImage && <meta property="og:image" content={shareImage} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
