---
// Sirene Callout: sirene-design-system/components/Callout. Use in .mdx posts:
// <Callout>A permission check belongs at the boundary…</Callout>
interface Props {
	label?: string;
}

const { label = 'Note' } = Astro.props;
---

<aside class="sr-callout">
	<span class="sr-callout__mark">
		<svg viewBox="0 0 22 22" aria-hidden="true">
			<g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
				<path d="M11 2c2.4 2.6 2.4 5.4 0 8-2.4-2.6-2.4-5.4 0-8zM11 20c-2.4-2.6-2.4-5.4 0-8 2.4 2.6 2.4 5.4 0 8zM2 11c2.6-2.4 5.4-2.4 8 0-2.6 2.4-5.4 2.4-8 0zM20 11c-2.6 2.4-5.4 2.4-8 0 2.6-2.4 5.4-2.4 8 0z"></path>
			</g>
			<circle cx="11" cy="11" r="1.6" fill="currentColor"></circle>
		</svg>
	</span>
	<p><strong>{label}.</strong> <slot /></p>
</aside>
