---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="logo" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<button id="theme-toggle" type="button" aria-label="Toggle dark mode">
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 16px;
		z-index: 10;
		max-width: var(--max-width);
		margin: 16px auto 0;
		padding: 0 24px;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 10px 12px 10px 24px;
		border-radius: 9999px;
		background: var(--paper);
		box-shadow: var(--shadow-nav);
	}
	.logo {
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 20px;
		letter-spacing: -0.025em;
		color: var(--heading);
		text-decoration: none;
		white-space: nowrap;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 4px;
	}
	button {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		margin-left: 4px;
		border: 1px solid var(--border);
		border-radius: 9999px;
		background: transparent;
		color: var(--text);
		cursor: pointer;
	}
	button:hover {
		color: var(--accent-text);
		border-color: var(--accent);
	}
	:global([data-theme='dark']) .sun,
	:global(:root:not([data-theme='dark'])) .moon {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 16px;
		}
		nav {
			padding: 8px 8px 8px 18px;
		}
		.logo {
			font-size: 17px;
		}
		.links {
			gap: 0;
		}
		.links :global(a) {
			padding: 8px 10px;
			font-size: 15px;
		}
	}
</style>
