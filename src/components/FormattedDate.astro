---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString('en-us', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		// Frontmatter dates (YYYY-MM-DD) are UTC midnight: format in UTC so the day never shifts with the build machine.
		timeZone: 'UTC',
	})}
</time>
