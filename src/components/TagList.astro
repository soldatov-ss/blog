---
// Sirene Tag: sirene-design-system/components/Tag
import { tagLabel, tagUrl } from '../posts';

interface Props {
	tags: string[];
	current?: string;
}

const { tags, current } = Astro.props;
---

<ul class="tag-list" aria-label="Tags">
	{tags.map((tag) => (
		<li>
			<a class="sr-tag" href={tagUrl(tag)} aria-current={tag === current ? 'page' : undefined}>
				{tagLabel(tag)}
			</a>
		</li>
	))}
</ul>
