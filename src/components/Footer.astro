---
// Sirene Footer: sirene-design-system/components/Footer (kilim band, deep panel, fringe)
import { NAV_LINKS, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';
---

<footer class="sr-footer">
	<div class="sr-kilim" aria-hidden="true"></div>
	<div class="sr-footer__inner">
		<p class="footer-tagline">{SITE_DESCRIPTION}</p>
		<div class="footer-links">
			{NAV_LINKS.map(({ href, label }) => (
				<a href={href}>{label}</a>
			))}
			<a href="/rss.xml">RSS feed</a>
		</div>
		<div class="footer-social">
			{SOCIAL_LINKS.map(({ label, href, icon }) => (
				<a class="sr-icon-btn" href={href} aria-label={label} rel="me">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d={icon} fill="currentColor" />
					</svg>
				</a>
			))}
		</div>
		<p class="footer-copy">
			&copy; {new Date().getFullYear()} {SITE_TITLE}
		</p>
	</div>
	<div class="sr-fringe" aria-hidden="true"></div>
</footer>
