---
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="inner">
		<div>
			<p class="name">{SITE_TITLE}</p>
			<p>{SITE_DESCRIPTION}</p>
		</div>
		<div class="cols">
			<div>
				<p class="label">Read</p>
				<a href="/blog">Articles</a>
				<a href="/rss.xml">RSS feed</a>
			</div>
			<div>
				<p class="label">Site</p>
				<a href="/">Home</a>
				<a href="/about">About</a>
			</div>
		</div>
	</div>
	<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>

<style>
	footer {
		margin-top: 120px;
		padding: 64px 24px 32px;
		background: var(--footer-bg);
		color: #a39ac1;
		font-size: 15px;
	}
	.inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 48px;
	}
	p {
		margin: 0 0 8px;
	}
	.name {
		font-family: var(--font-display);
		font-size: 22px;
		letter-spacing: -0.025em;
		color: #fff;
	}
	.cols {
		display: flex;
		gap: 80px;
	}
	.cols div {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.label {
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #fff;
	}
	a {
		color: #a39ac1;
		text-decoration: none;
	}
	a:hover {
		color: #fff;
	}
	.copy {
		max-width: var(--max-width);
		margin: 64px auto 0;
		padding-top: 24px;
		border-top: 1px solid rgba(163, 154, 193, 0.2);
		font-size: 12px;
		letter-spacing: 0.05em;
	}
</style>
