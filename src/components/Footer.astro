---
// Sirene Footer: sirene-design-system/components/Footer (kilim band, deep panel, fringe)
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<footer class="sr-footer">
	<div class="sr-kilim" aria-hidden="true"></div>
	<div class="sr-footer__inner">
		<div>
			<div class="sr-footer__mark">Serhii <em>Soldatov</em></div>
			<p class="footer-tagline">{SITE_DESCRIPTION}</p>
		</div>
		<div class="footer-links">
			<a href="/blog">Articles</a>
			<a href="/about">About</a>
			<a href="/rss.xml">RSS</a>
		</div>
		<p class="footer-copy">&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
	</div>
	<div class="sr-fringe" aria-hidden="true"></div>
</footer>
